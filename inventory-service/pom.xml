<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.orderflow</groupId>
        <artifactId>orderflow</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>inventory-service</artifactId>
    <name>inventory-service</name>
    <description>
        Consumes order-created events and checks/reserves stock. Through
        Build Order Step 7 this had no REST API at all — Step 8 gives it
        its first ever HTTP endpoints, not as a public API, but as an
        internal command interface order-saga-orchestrator calls
        synchronously, reusing the exact same StockService the
        choreography saga's Kafka listeners already use.
    </description>

    <dependencies>
        <!-- Upgraded from the plain "starter" to "-web" in Build Order
             Step 8 — this service now has real REST endpoints
             (internal/InternalReservationController.java), so it needs
             the embedded Tomcat + Jackson that starter-web brings and
             the bare starter deliberately didn't. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Build Order Step 3 retires the two Jackson dependencies that
             used to live here (jackson-databind, jackson-datatype-jsr310)
             — both were needed only because JsonDeserializer used Jackson
             under the hood. KafkaAvroDeserializer (below) doesn't touch
             Jackson at all. -->

        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
        </dependency>

        <!-- Same artifact as order-service's producer side — it bundles
             both KafkaAvroSerializer and KafkaAvroDeserializer, and this
             module only uses the latter. -->
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-avro-serializer</artifactId>
            <version>${confluent.version}</version>
        </dependency>

        <!-- Build Order Step 9: stock moves from an in-memory ConcurrentHashMap
             (per-instance, resets on restart) to Postgres — the real source of
             truth cache-aside needs something to sit IN FRONT OF. JdbcTemplate,
             not JPA, for the same reason order-service's outbox tables stayed
             plain SQL: one table, no relationships, nothing an ORM's session
             machinery would clarify. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis, via Spring Data Redis's RedisTemplate — used for THREE
             unrelated things in this one service: the cache-aside read
             layer in front of the stock table, a SETNX-based distributed
             lock preventing overselling across instances, and an
             idempotent-consumer dedupe store keyed by orderId. Lettuce
             (Spring Boot's default Redis client) is what's actually on
             the classpath here, not Jedis — chosen automatically by
             spring-boot-starter-data-redis, not something we picked. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Build Order Step 14 — see order-service/pom.xml's comment for
             the full explanation of why real containers, not embedded
             stand-ins. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Build Order Step 11 — see order-service/pom.xml's comment for
             the full explanation; identical reasoning applies to every
             service in this reactor. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>inventory-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Generates THIS module's own com.orderflow.avro.OrderCreatedEvent
                 from the SAME ../avro-schemas/order-created.avsc file
                 order-service generates from — see that module's pom.xml
                 for the full explanation of why each service generates
                 its own copy instead of sharing a compiled jar. -->
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>${avro.version}</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/../avro-schemas</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <stringType>String</stringType>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
