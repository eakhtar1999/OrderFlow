<?xml version="1.0" encoding="UTF-8"?>
<!--
    OrderFlow — parent (reactor) POM.

    This file itself teaches a concept: in a multi-module Maven build, this
    POM is never deployed as a runnable artifact (packaging = "pom"). Its
    only job is to (a) list which modules exist, and (b) pin shared
    dependency VERSIONS so every service uses the same Spring Boot / Spring
    Kafka release. Without this, order-service and inventory-service could
    silently drift onto different Kafka client versions and you'd get
    "works on my service" bugs that are miserable to debug.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        We inherit from spring-boot-starter-parent instead of declaring our
        own dependencyManagement. That gives every child module a curated,
        mutually-compatible set of versions (Spring Kafka, Jackson, Tomcat,
        etc.) for free — this is Spring Boot's own "bill of materials".
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.orderflow</groupId>
    <artifactId>orderflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- pom packaging = "this is a reactor, not a jar" -->
    <packaging>pom</packaging>
    <name>OrderFlow</name>
    <description>
        Real-time order processing platform used to teach Kafka + distributed
        systems concepts hands-on. See /README.md for the architecture and
        the build-order roadmap this repo follows.
    </description>

    <!--
        MODULE ROADMAP (see root README.md "Build Order" section).
        Only modules that actually exist are listed here — pointing at a
        directory that doesn't exist yet breaks the reactor build, so each
        module is added only when the tutorial reaches that step.

        Build Order Steps 1-8 (current):
          - order-service
          - inventory-service
          - fraud-detection-service (Kafka Streams)
          - analytics-service (Kafka Streams)
          - payment-service, shipment-service (the saga's remaining steps)
          - order-saga-orchestrator (orchestration variant, for comparison)

        Coming later as the tutorial progresses:
          - notification-service
          - search-indexer-service (Elasticsearch)
    -->
    <modules>
        <module>order-service</module>
        <module>inventory-service</module>
        <module>fraud-detection-service</module>
        <module>analytics-service</module>
        <module>payment-service</module>
        <module>shipment-service</module>
        <module>order-saga-orchestrator</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Spring Boot's parent manages the actual spring-kafka version -->

        <!-- Build Order Step 3: Avro + Schema Registry. Pinned here, once,
             so order-service and inventory-service — which each generate
             their OWN Java classes from the same .avsc file, see
             /avro-schemas — can never drift onto incompatible codegen or
             client versions the way the hand-copied DTOs could before. -->
        <avro.version>1.11.3</avro.version>
        <!-- Confluent's platform version, not Kafka's — cp-schema-registry
             in docker-compose.yml and kafka-avro-serializer below are
             pinned to the SAME Confluent release for a reason: Confluent's
             wire-format and client libraries version together. -->
        <confluent.version>7.7.0</confluent.version>
        <!-- Build Order Step 8: order-saga-orchestrator's circuit
             breaker + retry library. Not in Spring Boot's own BOM (it's
             a third-party project, not a Spring one), so pinned
             explicitly here like avro/confluent above. -->
        <resilience4j.version>2.2.0</resilience4j.version>
    </properties>

    <!-- kafka-avro-serializer / kafka-schema-registry-client aren't on
         Maven Central — Confluent publishes them from their own repo.
         Declared once here so no child module has to repeat it. -->
    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

</project>
