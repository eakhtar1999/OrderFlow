# Loaded automatically by Vitest (mode defaults to "test", and Vite's env
# loader checks .env.test / .env.test.local the same way it checks
# .env.local for dev/build) — see vite.config.ts's `test` block. Without
# this file, `npm run test` in CI (which has no .env.local — that file is
# gitignored, see .gitignore's `*.local` pattern) crashes immediately:
# src/config/env.ts's module-level `requireEnv` throws the moment any
# feature module imports it, since import.meta.env.VITE_ORDERS_API_URL
# etc. would otherwise be undefined.
#
# These values are never actually fetched from in tests — MSW
# (src/test/server.ts) intercepts every request before it reaches a real
# network. They only need to be syntactically present and distinct enough
# to satisfy env.ts's validation and MSW's handler URL matching.
VITE_ORDERS_API_URL=http://localhost:8080
VITE_SAGA_API_URL=http://localhost:8089
VITE_ANALYTICS_API_URL=http://localhost:8084
VITE_FRAUD_API_URL=http://localhost:8082
VITE_SEARCH_API_URL=http://localhost:8090
