<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.orderflow</groupId>
        <artifactId>orderflow</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>order-service</artifactId>
    <name>order-service</name>
    <description>
        REST entry point of the OrderFlow pipeline. Accepts "place an order"
        HTTP requests and turns them into an order-created Kafka event —
        the very first hop of the whole platform.
    </description>

    <dependencies>
        <!-- REST controller + embedded Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (@NotBlank, @Positive, ...) on the request DTO -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring's Kafka integration: KafkaTemplate, @KafkaListener, KafkaAdmin -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Avro runtime: SpecificRecordBase and friends, which every class
             avro-maven-plugin generates below (see build/plugins) extends. -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
        </dependency>

        <!-- Confluent's KafkaAvroSerializer: wraps each record with a
             5-byte magic-byte + schema-id header (NOT the schema itself —
             that's the whole point) and talks to Schema Registry over
             HTTP to register/look up schema ids, with a local cache so
             it's not a network call per message. -->
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-avro-serializer</artifactId>
            <version>${confluent.version}</version>
        </dependency>

        <!-- Build Order Step 5: order-service gets a database for the
             first time. JdbcTemplate, not Spring Data JPA — the whole
             point of this step is "look, here are two plain INSERTs in
             one transaction," and an ORM's session/entity-lifecycle
             machinery would bury that under abstraction we don't want
             for a two-table, no-relationships schema. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Build Order Step 9: Redis-backed token-bucket rate limiting on
             POST /api/orders — see rate/TokenBucketRateLimiter.java. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Build Order Step 11: /actuator/prometheus exposes every
             Micrometer metric this JVM has registered — JVM memory/GC,
             HTTP request latency (auto-instrumented for every
             @RestController), Kafka producer/consumer internals
             (including consumer LAG, Spring Kafka's Micrometer binder
             registers this automatically once a MeterRegistry bean
             exists), Kafka transaction metrics — in Prometheus's own
             text exposition format, scraped every 5s (see
             observability/prometheus/prometheus.yml). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>order-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Generates com.orderflow.avro.OrderCreatedEvent (and its
                 nested OrderItem) from ../avro-schemas/order-created.avsc
                 into target/generated-sources/avro at build time. Every
                 module that needs the type points this SAME plugin at the
                 SAME schema file and generates its OWN copy of the class —
                 no shared JAR between services, just a shared source file
                 and, at runtime, a shared registry that enforces they stay
                 compatible. -->
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>${avro.version}</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/../avro-schemas</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <!-- Generate java.lang.String fields instead of
                                 Avro's own Utf8 CharSequence type — Utf8 is
                                 marginally faster but every downstream
                                 equals()/instanceof String check in our own
                                 code would otherwise need to account for it. -->
                            <stringType>String</stringType>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
